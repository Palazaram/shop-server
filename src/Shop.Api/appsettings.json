{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5433;Database=shop;Username=shop;Password=shop_dev_password"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": {
      "console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "shop-api",
    "Audience": "shop-client",
    "AccessTokenExpirationMinutes": 5
  },
  "RefreshToken": {
    "LifetimeDays": 30,
    "RetentionDaysAfterExpiry": 30
  }
}